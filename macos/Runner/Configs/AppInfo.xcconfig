// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The human-readable application name shown in Finder and application information.
PRODUCT_NAME = Planstar

// Keep the executable filename stable while allowing a human-readable product name.
EXECUTABLE_NAME = planstar_desktop_app

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.example.planstarDesktopApp

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Planstar Team. All rights reserved.
